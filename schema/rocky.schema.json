{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/naranbat/rocky/main/schema/rocky.schema.json",
  "title": "Rocky project",
  "description": "A Rocky project file (rocky.yaml by default): its jobs and the settings they share. Job files use job.schema.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["jobs"],
  "properties": {
    "values": { "$ref": "#/$defs/variables" },
    "env_file": { "type": "string" },
    "defaults": { "$ref": "#/$defs/defaults" },
    "jobs": {
      "description": "Each job's name and YAML file, relative to this file.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[^./\\\\][^/\\\\]*$" },
      "additionalProperties": { "type": "string" }
    }
  },
  "$defs": {
    "duration": {
      "type": "string",
      "pattern": "^[0-9]+[smh]$",
      "examples": ["30s", "5m", "2h"]
    },
    "positiveDuration": {
      "type": "string",
      "pattern": "^0*[1-9][0-9]*[smh]$",
      "examples": ["30s", "5m", "2h"]
    },
    "varPath": {
      "type": "string",
      "anyOf": [
        { "not": { "pattern": "\\$\\{" } },
        { "pattern": "^\\$\\{(?:(?!\\$\\{|\\}).)*\\}$" }
      ]
    },
    "threshold": {
      "oneOf": [
        { "type": "number" },
        {
          "type": "string",
          "anyOf": [
            { "pattern": "\\$\\{" },
            {
              "pattern": "^[ \\t]*[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)(?:[eE][+-]?[0-9]+)?[ \\t]*$"
            }
          ]
        }
      ]
    },
    "variables": {
      "type": "object",
      "patternProperties": {
        "^[A-Z_][A-Z0-9_]*$": true
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "additionalProperties": true
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeout": { "$ref": "#/$defs/duration" },
        "cwd": { "type": "string" },
        "env": { "$ref": "#/$defs/environment" },
        "retry": { "$ref": "#/$defs/retry" }
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tasks"],
      "properties": {
        "schedule": { "$ref": "#/$defs/schedule" },
        "values": { "$ref": "#/$defs/variables" },
        "defaults": { "$ref": "#/$defs/defaults" },
        "tasks": { "$ref": "#/$defs/nonEmptyTaskMap" }
      }
    },
    "schedule": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["every"],
          "properties": {
            "every": { "$ref": "#/$defs/positiveDuration" },
            "delay": { "$ref": "#/$defs/duration" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["hourly"],
          "properties": {
            "hourly": { "type": "integer", "minimum": 0, "maximum": 59 },
            "run_on_start": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["daily"],
          "properties": {
            "daily": { "$ref": "#/$defs/time" },
            "run_on_start": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["weekly"],
          "properties": {
            "weekly": {
              "type": "object",
              "additionalProperties": false,
              "required": ["days", "time"],
              "properties": {
                "days": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"]
                  }
                },
                "time": { "$ref": "#/$defs/time" }
              }
            },
            "run_on_start": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["at"],
          "properties": {
            "at": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?([+-][0-9]{2}:[0-9]{2})?$"
            },
            "run_on_start": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["run_on_start"],
          "properties": {
            "run_on_start": { "const": true }
          }
        }
      ]
    },
    "time": {
      "type": "string",
      "pattern": "^[0-9]{2}:[0-9]{2}(:[0-9]{2}(\\.[0-9]+)?)?$",
      "examples": ["09:30", "09:30:15"]
    },
    "taskMap": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(?!tasks$)[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": { "$ref": "#/$defs/task" }
    },
    "nonEmptyTaskMap": {
      "allOf": [
        { "$ref": "#/$defs/taskMap" },
        { "minProperties": 1 }
      ]
    },
    "task": {
      "oneOf": [
        { "$ref": "#/$defs/cmdTask" },
        { "$ref": "#/$defs/forEachTask" },
        { "$ref": "#/$defs/whileTask" },
        { "$ref": "#/$defs/triggerTask" }
      ]
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "cmdTask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cmd"],
      "properties": {
        "cmd": { "$ref": "#/$defs/command" },
        "pipe": {
          "type": "array",
          "items": { "$ref": "#/$defs/command" }
        },
        "timeout": { "$ref": "#/$defs/duration" },
        "cwd": { "type": "string" },
        "stdin": true,
        "env": { "$ref": "#/$defs/environment" },
        "capture_stdout": { "type": "boolean" },
        "stdout_file": { "type": "string" },
        "retry": { "$ref": "#/$defs/retry" },
        "allow_failure": { "type": "boolean" },
        "when": { "$ref": "#/$defs/condition" }
      },
      "not": {
        "required": ["capture_stdout", "stdout_file"]
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempts"],
      "properties": {
        "attempts": { "type": "integer", "minimum": 1 },
        "delay": { "$ref": "#/$defs/duration" },
        "until": { "$ref": "#/$defs/condition" }
      }
    },
    "forEachTask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["for_each", "do"],
      "properties": {
        "for_each": { "$ref": "#/$defs/varPath" },
        "as": { "type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$" },
        "do": { "$ref": "#/$defs/nonEmptyTaskMap" },
        "on_failure": { "enum": ["stop", "next"] },
        "when": { "$ref": "#/$defs/condition" }
      }
    },
    "whileTask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["while", "do"],
      "properties": {
        "while": { "$ref": "#/$defs/condition" },
        "attempts": { "type": "integer", "minimum": 1 },
        "do": { "$ref": "#/$defs/nonEmptyTaskMap" },
        "on_failure": { "enum": ["stop", "next"] },
        "when": { "$ref": "#/$defs/condition" }
      }
    },
    "triggerTask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger"],
      "properties": {
        "trigger": { "type": "string" },
        "when": { "$ref": "#/$defs/condition" }
      }
    },
    "condition": {
      "oneOf": [
        {
          "type": "array",
          "items": { "$ref": "#/$defs/condition" }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["this"],
          "properties": {
            "this": { "$ref": "#/$defs/varPath" },
            "gt": { "$ref": "#/$defs/threshold" },
            "gte": { "$ref": "#/$defs/threshold" },
            "lt": { "$ref": "#/$defs/threshold" },
            "lte": { "$ref": "#/$defs/threshold" },
            "eq": true,
            "ne": true,
            "contains": true,
            "matches": { "type": "string" }
          },
          "anyOf": [
            { "required": ["gt"] },
            { "required": ["gte"] },
            { "required": ["lt"] },
            { "required": ["lte"] },
            { "required": ["eq"] },
            { "required": ["ne"] },
            { "required": ["contains"] },
            { "required": ["matches"] }
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["this", "exists"],
          "properties": {
            "this": { "$ref": "#/$defs/varPath" },
            "exists": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["all"],
          "properties": {
            "all": {
              "type": "array",
              "items": { "$ref": "#/$defs/condition" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["any"],
          "properties": {
            "any": {
              "type": "array",
              "items": { "$ref": "#/$defs/condition" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["not"],
          "properties": {
            "not": { "$ref": "#/$defs/condition" }
          }
        }
      ]
    }
  }
}
